# KGGen / DeepSeek API 配置
KGGEN_API_KEY=your_api_key_here
KGGEN_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# Neo4j 数据库配置
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# BERT 模型路径 (留空则使用默认 bert-base-chinese)
BERT_MODEL_PATH=
# LTP 模型路径
LTP_MODEL_PATH=

# 数据目录
DATA_DIR=./data
